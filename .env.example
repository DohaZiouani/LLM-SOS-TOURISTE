# Clé API Groq (gratuite) — https://console.groq.com  → API Keys
GROQ_API_KEY=urkeyhereaghzal

# Optionnel — modèle Groq (défaut : llama-3.1-8b-instant)
# GROQ_MODEL=llama-3.1-8b-instant

# Optionnel — modèle d'embeddings (défaut : intfloat/multilingual-e5-large)
# EMBED_MODEL=intfloat/multilingual-e5-large

# Optionnel — chemin local de Qdrant (défaut : ./qdrant_data)
# QDRANT_PATH=./qdrant_data
